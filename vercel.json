{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/portfolio.mjs": { "includeFiles": "server/**", "maxDuration": 30 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/portfolio" },
    { "source": "/uploads/:path*", "destination": "/api/portfolio" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "X-Frame-Options", "value": "DENY" },
    { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
  ]}]
}
