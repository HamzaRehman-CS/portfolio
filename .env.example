# For a NEW server only. Never use a VITE_ prefix for credentials.
# ADMIN_PASSWORD=choose-a-long-unique-password
PORT=3001
HOST=127.0.0.1
# Production requires HTTPS; set HOST=0.0.0.0 behind your HTTPS reverse proxy.
# NODE_ENV=production
# APP_ORIGIN=https://your-domain.example
# DATA_DIR=/var/lib/portfolio
# Vercel / Production: configure these in the project dashboard (server-only).
# Option A: Supabase (Recommended)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key
# SUPABASE_STORAGE_BUCKET=portfolio

# Option B: Upstash Redis
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-writable-token
# PORTFOLIO_STORAGE_PREFIX=portfolio
